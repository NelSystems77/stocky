rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ───────── Helpers ─────────
    function autenticado() {
      return request.auth != null;
    }
    function esSuperadmin() {
      return autenticado() && request.auth.token.role == 'superadmin';
    }
    function esDueno(uid) {
      return autenticado() && request.auth.uid == uid;
    }
    function esUsuario() {
      return autenticado() && request.auth.token.role == 'usuario';
    }
    function esUnidad771() {
      return esUsuario() && request.auth.token.unidad == '771';
    }
    // La farmacia 772 solo ve Tareas, Agotados, Vencimientos y Reportes (+ sus datos de soporte),
    // salvo módulos que el 771 le habilite en `modulosHabilitados`.
    function modulosBase772() {
      return ['tareas', 'agotados', 'inventario'];
    }
    function moduloHabilitado(uid, modulo) {
      return modulo in get(/databases/$(database)/documents/usuarios/$(uid)).data.modulosHabilitados;
    }
    function puedeModulo(uid, modulo) {
      return esUnidad771()
        || (esUsuario() && request.auth.token.unidad == '772'
            && (modulo in modulosBase772() || moduloHabilitado(uid, modulo)));
    }
    function accesoModulo(uid, modulo) {
      return esSuperadmin() || (esDueno(uid) && puedeModulo(uid, modulo));
    }
    function soloCampos(permitidos) {
      return request.resource.data.keys().hasOnly(permitidos);
    }
    // Pedido o envío programado (`tiposPedido` y `puestos`).
    function programadoValido() {
      return soloCampos(['nombre', 'recurrencias', 'anticipacion', 'activo', 'desde', 'notas'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() > 0
        && request.resource.data.nombre.size() <= 100
        && request.resource.data.recurrencias is list
        && request.resource.data.recurrencias.size() > 0
        && request.resource.data.recurrencias.size() <= 6
        && request.resource.data.anticipacion is int
        && request.resource.data.anticipacion >= 0
        && request.resource.data.anticipacion <= 10
        && request.resource.data.activo is bool
        && request.resource.data.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.notas is string
        && request.resource.data.notas.size() <= 500;
    }

    // ───────── Catálogo compartido ─────────
    // Lectura para autenticados. Los códigos nuevos solo se crean (nunca se editan ni borran)
    // desde la importación validada; el resto lo gestiona el superadmin.
    match /catalogo/{codigo} {
      allow read: if autenticado();
      allow create: if esUsuario()
        && codigo.matches('^([0-9]-[0-9]{2}-[0-9]{2}-[0-9]{4}|[0-9]{3}-[0-9]{2}-[0-9]{4})$')
        && soloCampos(['descripcion', 'ud', 'factorUnidad', 'nuevo', 'creadoEn'])
        && request.resource.data.descripcion is string
        && request.resource.data.descripcion.size() > 0
        && request.resource.data.descripcion.size() <= 300
        && request.resource.data.ud is string
        && request.resource.data.factorUnidad is number
        && request.resource.data.factorUnidad > 0
        && request.resource.data.nuevo is bool;
      allow update, delete: if esSuperadmin();
    }

    // ───────── Cuentas ─────────
    // Los claims, `unidad` y `modulosHabilitados` solo los escribe una Cloud Function (Admin SDK).
    match /usuarios/{uid} {
      allow read: if esDueno(uid) || esSuperadmin();
      allow update: if esDueno(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'ajustes', 'tokensFCM']);
      allow create, delete: if false;

      // ───────── Datos del usuario (solo el dueño o el superadmin) ─────────
      match /importaciones/{id} {
        allow read: if accesoModulo(uid, 'inventario');
        allow create: if accesoModulo(uid, 'inventario')
          && request.resource.data.tipoReporte is string
          && request.resource.data.fechaReporte is timestamp;
        allow update, delete: if accesoModulo(uid, 'inventario');
      }
      // Detalle de cada cambio de una carga de lotes (lo que la persona revisó antes de guardar).
      match /importaciones/{id}/cambios/{c} {
        allow read: if accesoModulo(uid, 'inventario');
        allow create, update: if accesoModulo(uid, 'inventario')
          && request.resource.data.tipo in ['nuevo', 'salio', 'bajo', 'subio', 'vencimiento']
          && request.resource.data.codigo is string
          && request.resource.data.lote is string
          && request.resource.data.vence.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
        allow delete: if accesoModulo(uid, 'inventario');
      }
      match /existencias/{codigo} {
        allow read, write: if accesoModulo(uid, 'inventario');
      }
      // Lotes con vencimiento (carga del reporte de lotes). Cantidad en unidades base; nunca se borran (queda `agotado`).
      match /lotes/{id} {
        allow read, delete: if accesoModulo(uid, 'inventario');
        allow create, update: if accesoModulo(uid, 'inventario')
          && request.resource.data.codigo is string
          && request.resource.data.codigo.size() > 0
          && request.resource.data.lote is string
          && request.resource.data.lote.size() > 0
          && request.resource.data.lote.size() <= 60
          && request.resource.data.vence.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.cantidad is number
          && request.resource.data.cantidad >= 0
          && request.resource.data.estado in ['activo', 'gestionado', 'vencido', 'agotado'];
      }
      match /consumos/{id} {
        allow read, write: if accesoModulo(uid, 'inventario');
      }
      // Registro de agotados: fechas civiles `YYYY-MM-DD`; `fechaIngreso` es null mientras siga agotado.
      match /agotados/{id} {
        allow read, delete: if accesoModulo(uid, 'agotados');
        allow create, update: if accesoModulo(uid, 'agotados')
          && request.resource.data.codigo is string
          && request.resource.data.codigo.size() > 0
          && request.resource.data.fechaAgotado is string
          && request.resource.data.fechaAgotado.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && (request.resource.data.fechaIngreso == null
              || (request.resource.data.fechaIngreso is string
                  && request.resource.data.fechaIngreso.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && request.resource.data.origen in ['detectado', 'manual']
          && request.resource.data.notas is string
          && request.resource.data.notas.size() <= 500;
      }
      // Plantillas de tareas (únicas o recurrentes). Lo hecho/pospuesto vive en `cumplimientos`.
      match /tareas/{id} {
        allow read, delete: if accesoModulo(uid, 'tareas');
        allow create, update: if accesoModulo(uid, 'tareas')
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() > 0
          && request.resource.data.titulo.size() <= 200
          && request.resource.data.prioridad in ['alta', 'media', 'baja']
          && request.resource.data.activa is bool
          && request.resource.data.recurrencia is map
          && request.resource.data.recurrencia.tipo in ['unica', 'diaria', 'diasSemana', 'quincenal', 'mensual', 'segundoSabado', 'tercerJueves', 'tercerJuevesMas15']
          && request.resource.data.desde.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
      }
      // Una fila por ocurrencia atendida: id = `${tareaId}_${fechaOrigen}`.
      match /cumplimientos/{id} {
        allow read, delete: if accesoModulo(uid, 'tareas');
        allow create, update: if accesoModulo(uid, 'tareas')
          && request.resource.data.tareaId is string
          && request.resource.data.fechaOrigen.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.estado in ['hecha', 'pospuesta', 'descartada']
          && (!('fechaProgramada' in request.resource.data)
              || request.resource.data.fechaProgramada.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'));
      }
      // Pedidos (tipos) y envíos (puestos): misma forma; la colección dice cuál es cuál. Solo el 771.
      match /tiposPedido/{id} {
        allow read, delete: if accesoModulo(uid, 'pedidos');
        allow create, update: if accesoModulo(uid, 'pedidos') && programadoValido();
      }
      match /puestos/{id} {
        allow read, delete: if accesoModulo(uid, 'envios');
        allow create, update: if accesoModulo(uid, 'envios') && programadoValido();
      }
      // Una fila por ocurrencia atendida: id = `${programadoId}_${fecha}`.
      match /seguimientos/{id} {
        allow read, delete: if accesoModulo(uid, 'pedidos') || accesoModulo(uid, 'envios');
        allow create, update: if (accesoModulo(uid, 'pedidos') || accesoModulo(uid, 'envios'))
          && soloCampos(['programadoId', 'fecha', 'estado'])
          && request.resource.data.programadoId is string
          && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.estado in ['en_tramite', 'enviado'];
      }
      match /espacios/{id} {
        allow read, write: if accesoModulo(uid, 'ubicaciones');
      }
      match /ubicaciones/{id} {
        allow read, write: if accesoModulo(uid, 'ubicaciones');
      }
      // Preconteo: cantidades en unidades base; `recibida` es null hasta que vuelve el producto precontado.
      match /preconteos/{id} {
        allow read, delete: if accesoModulo(uid, 'preconteo');
        allow create, update: if accesoModulo(uid, 'preconteo')
          && request.resource.data.codigo is string
          && request.resource.data.codigo.size() > 0
          && request.resource.data.fecha is string
          && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.cantidad is number
          && request.resource.data.cantidad > 0
          && request.resource.data.presentacion is int
          && request.resource.data.presentacion > 0
          && (request.resource.data.recibida == null
              || (request.resource.data.recibida is number && request.resource.data.recibida >= 0))
          && request.resource.data.notas is string
          && request.resource.data.notas.size() <= 500;
      }
      match /traslados/{id} {
        allow read, delete: if accesoModulo(uid, 'traslados');
        allow create, update: if accesoModulo(uid, 'traslados')
          && request.resource.data.ordenSAP is string
          && request.resource.data.ordenSAP.matches('^50000[0-9]*$')
          && request.resource.data.tipo in ['envio', 'recepcion']
          && request.resource.data.unidad is string
          && request.resource.data.unidad.size() > 0
          && request.resource.data.unidad.size() <= 80
          && request.resource.data.fecha is string
          && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.estado in ['pendiente', 'recibido', 'enviado']
          && (request.resource.data.fechaCierre == null
              || (request.resource.data.fechaCierre is string
                  && request.resource.data.fechaCierre.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
          && request.resource.data.enSAP is bool
          && request.resource.data.enSIFA is bool
          && request.resource.data.notas is string
          && request.resource.data.notas.size() <= 500;
      }
      // Dañados: cantidad en unidades base (> 0), fecha civil, foto opcional (ruta en Storage).
      match /danados/{id} {
        allow read, delete: if accesoModulo(uid, 'danados');
        allow create, update: if accesoModulo(uid, 'danados')
          && request.resource.data.codigo is string
          && request.resource.data.codigo.size() > 0
          && request.resource.data.fecha is string
          && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.lote is string
          && request.resource.data.lote.size() <= 40
          && request.resource.data.cantidad is number
          && request.resource.data.cantidad > 0
          && request.resource.data.motivo in ['quebrado', 'derramado', 'otro']
          && request.resource.data.notas is string
          && request.resource.data.notas.size() <= 500
          && (request.resource.data.fotoRuta == null || request.resource.data.fotoRuta is string);
      }
      // Vencidos (RF-2.5): cantidad en unidades base (> 0), fechas civiles. Origen manual o del reporte de lotes.
      match /vencidos/{id} {
        allow read, delete: if accesoModulo(uid, 'inventario');
        allow create, update: if accesoModulo(uid, 'inventario')
          && request.resource.data.codigo is string
          && request.resource.data.codigo.size() > 0
          && request.resource.data.lote is string
          && request.resource.data.lote.size() > 0
          && request.resource.data.lote.size() <= 40
          && request.resource.data.fecha is string
          && request.resource.data.fecha.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.fechaVencimiento is string
          && request.resource.data.fechaVencimiento.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.cantidad is number
          && request.resource.data.cantidad > 0
          && request.resource.data.origen in ['manual', 'reporte']
          && request.resource.data.notas is string
          && request.resource.data.notas.size() <= 500;
      }
      // Historial de Chango IA: lo escribe solo la Cloud Function (Admin SDK); el cliente solo puede leerlo.
      // `changoUso/*` (contador diario) no tiene regla: queda cerrado para todos los clientes.
      match /changoIA/{id} {
        allow read: if accesoModulo(uid, 'chango');
        allow write: if false;
      }
    }

    // Todo lo demás, denegado.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
