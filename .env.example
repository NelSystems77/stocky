# Config web de Firebase (pública por diseño). Copiar a .env.local con los valores del proyecto stocky-bbda4.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=stocky-bbda4.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=stocky-bbda4
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=stocky-bbda4.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=316940592609
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Solo desarrollo local: apuntar a los emuladores (npm run emulators).
# NEXT_PUBLIC_USE_EMULATORS=true

# Clave pública VAPID (Firebase Console → Configuración del proyecto → Cloud Messaging → Certificados web push)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Clave de sitio pública de reCAPTCHA Enterprise para App Check (Google Cloud → Seguridad → reCAPTCHA)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
